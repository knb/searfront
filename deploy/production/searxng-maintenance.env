SEARXNG_COMPOSE_FILE=/srv/searfront/compose.yml
SEARXNG_SETTINGS_PATH=/srv/searfront/searxng-settings.yml
SEARXNG_MAINTENANCE_STATE_DIR=/var/lib/searfront/searxng-maintenance
SEARXNG_COMPOSE_SERVICE=searxng

SEARXNG_COMPOSE_IMAGE_VARIABLE=SEARXNG_IMAGE
SEARXNG_COMPOSE_LATEST_VALUE=docker.io/searxng/searxng:latest
SEARXNG_COMPOSE_ROLLBACK_VALUE=docker.io/searxng/searxng:searfront-rollback

SEARXNG_HEALTH_MODE=compose
SEARXNG_INTERNAL_BASE_URL=http://127.0.0.1:8080/
SEARXNG_ENGINE_ROTATIONS="google,duckduckgo;bing,brave;qwant,mojeek"
SEARXNG_SMOKE_QUERY=SearXNG
SEARXNG_SMOKE_MIN_RESULTS=1
SEARXNG_HEALTH_ATTEMPTS=12
SEARXNG_HEALTH_INTERVAL_SECONDS=5

SEARFRONT_BASE_URL=http://127.0.0.1:13000
