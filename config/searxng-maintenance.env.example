# SearXNG Compose deployment managed by script/searxng-maintenance.
SEARXNG_COMPOSE_FILE=/home/kensei/sites/searxng/compose.yaml
SEARXNG_SETTINGS_PATH=/home/kensei/sites/searxng/core-config/settings.yml
SEARXNG_COMPOSE_SERVICE=core
SEARXNG_BASE_URL=http://127.0.0.1:8080/

# The Compose image field must reference this variable, for example:
# image: ${SEARXNG_IMAGE:-docker.io/searxng/searxng:latest}
SEARXNG_COMPOSE_IMAGE_VARIABLE=SEARXNG_IMAGE
SEARXNG_COMPOSE_LATEST_VALUE=docker.io/searxng/searxng:latest
SEARXNG_COMPOSE_ROLLBACK_VALUE=docker.io/searxng/searxng:searfront-rollback

# Use compose when SearXNG is intentionally not published on the host.
SEARXNG_HEALTH_MODE=http
SEARXNG_INTERNAL_BASE_URL=http://127.0.0.1:8080/

# Semicolon-separated daily groups; comma-separated engines in each group.
SEARXNG_ENGINE_ROTATIONS="google,duckduckgo;bing,brave;qwant,mojeek"

SEARXNG_SMOKE_QUERY=SearXNG
SEARXNG_SMOKE_MIN_RESULTS=1
SEARXNG_HEALTH_ATTEMPTS=12
SEARXNG_HEALTH_INTERVAL_SECONDS=5

# Optional end-to-end searfront smoke check after the direct SearXNG smoke.
# SEARFRONT_BASE_URL=http://127.0.0.1:3000
# SEARFRONT_TOKEN=replace-me
