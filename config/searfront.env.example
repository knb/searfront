# Copy these values into your deployment secret manager or local .env file.
# Do not commit real secrets.

RAILS_ENV=production
RAILS_LOG_LEVEL=info

# Format: id:secret:role,id2:secret2:role2
# Roles currently used by the app: user, admin
SEARFRONT_API_TOKENS=agent:change-me:user,admin:change-me-admin:admin
SEARFRONT_RATE_LIMIT_PER_MINUTE=60

# Normal SearXNG path
SEARXNG_BASE_URL=http://searxng:8080/

# Browser fallback path
BROWSER_WORKER_BASE_URL=http://browser-worker:3000/
BROWSER_WORKER_TOKEN=change-me-internal-token
BROWSER_SEARCH_ENGINE=google

# Redis roles may point at one Redis instance initially, but keep URLs separated.
CACHE_REDIS_URL=redis://redis:6379/0
STATE_REDIS_URL=redis://redis:6379/1
SIDEKIQ_REDIS_URL=redis://redis:6379/2

# Cache and async request status
SEARCH_RESULT_TTL_SECONDS=1800
SEARCH_STALE_TTL_SECONDS=43200
REQUEST_STATUS_TTL_SECONDS=600
MINIMUM_RESULTS=3
SINGLE_FLIGHT_LOCK_MS=45000

# Browser execution control
BROWSER_TIMEOUT_MS=35000
BROWSER_MIN_INTERVAL_SECONDS=15
BROWSER_JITTER_SECONDS=5
CAPTCHA_SUSPEND_SECONDS=86400
RATE_LIMIT_SUSPEND_SECONDS=7200
